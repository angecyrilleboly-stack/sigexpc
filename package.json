{
  "name": "sigexpc",
  "version": "2.0.0",
  "description": "SIGEXPC - Système de Gestion des Examens du Permis de Conduire (Côte d'Ivoire). Version moderne Node.js + Express + SQLite.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "init-db": "node src/config/init-db.js",
    "seed": "node src/config/seed.js",
    "migrate": "node src/config/migrate-from-xlsx.js",
    "fix-data": "node src/config/fix-data.js",
    "render-build": "node --experimental-sqlite src/config/render-init.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "permis",
    "conduire",
    "auto-ecole",
    "examen",
    "cote-ivoire",
    "sigexpc"
  ],
  "author": "SIGEXPC",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "xlsx": "^0.18.5"
  }
}
