{
  "builds": [
    { "src": "api.js", "use": "@vercel/node", "config": { "includeFiles": "public/**" } },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(.*)", "headers": { "cache-control": "public, max-age=0, must-revalidate" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api.js" }
  ]
}
