# ============================================================
#  SIGEXPC - Fichier de configuration environnement
#  Copiez ce fichier en ".env" puis adaptez les valeurs.
# ============================================================

# --- Serveur ---
PORT=3000
NODE_ENV=development

# --- Base de données ---
# Par défaut : SQLite (AUCUNE installation, fichier data/sigexpc.db)
# Pour MySQL : DB_USE_MYSQL=true et renseignez les infos ci-dessous
DB_USE_MYSQL=false
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sigexpc

# --- Session / Sécurité ---
SESSION_SECRET=changez-cette-cle-secrete-en-production

# --- Paramètres d'abonnement par défaut ---
ABO_MONTANT=15000
ABO_DUREE_JOURS=30

# --- Paiement (GeniusPay) - optionnel ---
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
